{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "f1_legends-backend",
      "framework": "express",
      "entrypoint": "app.js"
    },
    "frontend": {
      "root": "f1_legends-frontend",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/drivers/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/drivers",
      "destination": { "service": "backend" }
    },
    {
      "source": "/constructors/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/constructors",
      "destination": { "service": "backend" }
    },
    {
      "source": "/races/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/races",
      "destination": { "service": "backend" }
    },
    {
      "source": "/steps/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/steps",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
