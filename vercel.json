{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "f1_legends-backend": {
      "root": "f1_legends-backend",
      "framework": "express"
    },
    "f1_legends-frontend": {
      "root": "f1_legends-frontend"
    }
  },
  "rewrites": [
    {
      "source": "/drivers/(.*)",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/drivers",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/constructors/(.*)",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/constructors",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/races/(.*)",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/races",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/steps/(.*)",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/steps",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/api",
      "destination": { "service": "f1_legends-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "f1_legends-frontend" }
    }
  ]
}
